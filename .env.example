# Native development. These are synthetic demo settings, not credentials.
# scripts/dev.sh uses environment variables; it does not source this file.
BIND_ADDR=127.0.0.1:8080
DATABASE_URL=sqlite://.data/flo.db
API_PROXY_TARGET=http://127.0.0.1:8080
# Android emulator: pass -PAPI_BASE_URL=http://10.0.2.2:8080 when building debug.
