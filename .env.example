# Native development. These are synthetic demo settings, not credentials.
# scripts/dev.sh uses environment variables; it does not source this file.
BIND_ADDR=127.0.0.1:8080
DATABASE_URL=sqlite://.data/flo.db
API_PROXY_TARGET=http://127.0.0.1:8080
# Android emulator: pass -PAPI_BASE_URL=http://10.0.2.2:8080 when building debug.

# Authentication. scripts/dev.sh explicitly selects local HTTP development defaults.
# Use Secure cookies and your exact HTTPS origin on a public installation.
COOKIE_SECURE=true
TRUSTED_ORIGINS=https://flo.example.com
JWT_SECRET_FILE=.data/jwt.key
# Optional alternative: set JWT_SECRET to a cryptographically random secret (>=32 bytes).
# Do not commit a real secret; the server can create a private local key file.

# Canonical web origin used to build partner invitations.
PUBLIC_APP_URL=https://flo.example.com
